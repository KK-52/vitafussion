# VitaFusion AI — Environment Variables
# Copy this file to .env and fill in your values

# ─── LLM Provider ───────────────────────────────────────
# Choose: "openai" | "gemini" | "ollama"
LLM_PROVIDER=gemini

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── App Settings ───────────────────────────────────────
DEMO_MODE=true
LOG_LEVEL=INFO
